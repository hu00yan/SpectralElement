$HistoryLength = 0;
out = {};
p[args___] := (AppendTo[out, ToString[Row[{args}], InputForm]]; Print[Row[{args}]]);
emx[v_] := If[TrueQ[VectorQ[Flatten[v], NumericQ]], N[Max[Abs[Flatten[v]]]], -1.];
Get["/Users/huyan00/mycode/SpectralElement/Kernel/SpectralElement.wl"];
p["load: msgs=", Cases[$MessageList, _Message]];
uexz[x_, y_] := Sin[2 x + 1] Cos[3 y - 1] + x y/5;
fLin = -Laplacian[uexz[x, y], {x, y}];
bdR = Abs[x + 1.5] < 1.*^-8 || Abs[x - 1.8] < 1.*^-8 || Abs[y + 1.2] < 1.*^-8 || Abs[y - 1.3] < 1.*^-8;
r = SpectralElement`SpectralNDSolve[{-Laplacian[u[x, y], {x, y}] == fLin, DirichletCondition[u[x, y] == uexz[x, y], bdR]}, u, {x, y} \[Element] Rectangle[{-1.5, -1.2}, {1.8, 1.3}], 16];
i = SpectralElement`Private`seLastSolve;
p["PUBLIC shape: ", Head[r], " len=", Length[r], " inner=", Head[First[r]], " rhs=", Head[First[First[r]]][[2]]];
p["method=", i["Method"], " opc=", i["OpCoefficient"], " conv=", i["Converged"], " res=", N[i["FinalResidual"]]];
sy = i["Disc"]["System"];
oo = i["Disc"]["PatchOps"][[1]];
nn = i["Disc"]["NodeCount"];
rws = sy["PDE"][[1]]["Rows"];
nod = Flatten[Transpose[Table[uexz[oo["Xs"][[ix, iy]], oo["Ys"][[ix, iy]]], {ix, 1, nn}, {iy, 1, nn}]]];
zex = nod[[rws]];
l1 = Lookup[Lookup[i, "Parts"], "Lift"][[1]];
A0 = i["OperatorMatrix"];
rhs = i["RHS"];
p["BLOCKER residual of the EXACT nodal solution in the assembled system = ", emx[A0.zex + i["LiftConst"] - rhs]];
zz = i["Global"];
p["(A0.zz + c0 - rhs) at the COMPUTED solution = ", emx[A0.zz + i["LiftConst"] - rhs]];
p["|zz - exact nodal| = ", emx[zz - zex]];
p["msgs after solve=", Cases[$MessageList, _Message]];
p["DONE-final"];
