Cell[BoxData[GridBox[{{"", Cell[TextData[{
  Cell[BoxData["SpectralDomainData[disc, \"key\"]"], "InlineFormula"],
  " \[LineSeparator]",
  "SpectralDomainData[disc, \"key\"] extracts a property of a SpectralDiscretization.  Keys include \"Nodes\", \"InterfacePairs\", \"PatchCount\", \"Degree\", \"PatchMap\", \"Jacobian\", \"InteriorRows\", \"BoundaryRows\", \"FluxRows\" and \"UnknownCount\"."
}]]}}]], "Usage", CellID->982511436]
}, Open]],
Cell[CellGroupData[{
Cell[BoxData["Details and Options"], "NotesSection",
  WholeCellGroupOpener->True, CellGroupingRules->{"SectionGrouping", 50},
  CellID->200000038],
Cell[BoxData["SpectralDomainData[disc, \"key\"] extracts one property of a
          SpectralDiscretization. An unknown key is refused by name with
          SpectralDomain::key, which lists the keys that do exist; it does not
          return $Failed silently."], "Notes", CellID->200000039],
Cell[BoxData["Sizes and shapes"], "NotesHead", CellID->200000040],
Cell[BoxData[GridBox[{{"{\"PatchCount\", \"Degree\"}",
   "how many patches, and the degree of each"},
{"{\"UnknownCount\", \"RowCount\"}",
   "the assembled unknowns, and the equations. RowCount equal to UnknownCount is what shows the Dirichlet lifting left a square system"},
{"{\"Nodes\", \"NodeCount\", \"NodesPerPatch\"}",
   "the Chebyshev-Gauss-Lobatto nodes; n+1 per direction"},
{"{\"Coordinates\", \"X\", \"Y\"}",
   "the physical node positions. Coordinates is one {x, y} pair per node, shaped {patchCount, nn, nn, 2}, and is the pairing of X and Y"}}]], "Notes", CellID->200000041],
Cell[BoxData["Geometry"], "NotesHead", CellID->200000042],
Cell[BoxData[GridBox[{{"{\"PatchMap\", \"Jacobian\", \"MinJacobian\"}",
   "the transfinite map, the per-node Jacobian, and its minimum. One MinJacobian entry per patch"},
{"{\"CornerJacobian\", \"NonPositiveJacobianCount\"}",
   "the degenerate spots to look for before trusting the metric coefficients"}}]], "Notes", CellID->200000043],
Cell[BoxData["Coupling and rows"], "NotesHead", CellID->200000044],
Cell[BoxData[GridBox[{{"{\"InterfacePairs\", \"InterfaceCount\"}",
   "the shared edges, and how many there are. Empty on a one-patch domain"},
{"{\"InteriorRows\", \"BoundaryRows\", \"FluxRows\"}",
   "the row classification. FluxRows holds one normal-flux continuity row per shared interior node"},
{"{\"Matrix\", \"Class\", \"RowOrder\", \"RowSlices\"}",
   "the assembled system, in the row order the rows above describe"}}]], "Notes", CellID->200000045],
Cell[BoxData["The full key set is enumerated in Kernel/Discretization.wl, and the three
          coordinate views X, Y and Coordinates are served by the accessor, so
          Keys[disc] does not list them."], "Notes", CellID->200000046]
}, Open]],
Cell[CellGroupData[{
Cell[BoxData[{"Examples", "\[NonBreakingSpace]\[NonBreakingSpace]", Cell["(1)", "ExampleCount"]}],
  "PrimaryExamplesSection", CellTags->"PrimaryExamplesSection",
  CellID->200000047],
Cell[CellGroupData[{
Cell[BoxData["Basic Examples"], "ExampleSection", "ExampleSection",
  WholeCellGroupOpener->True, CellID->200000048],
Cell["Build a discretization to inspect. This one is a unit square at degree
      8.", "ExampleText", CellID->200000049],
Cell[CellGroupData[{
Cell[BoxData["disc = SpectralDomain[Rectangle[{-1, -1}, {1, 1}], 8];
None"], "Input", CellLabel->"In[1]:=", CellID->200000050]
}, Open]],
Cell["How many patches, and at what degree.", "ExampleText", CellID->200000051],
Cell[CellGroupData[{
Cell[BoxData["{SpectralDomainData[disc, \"PatchCount\"], SpectralDomainData[disc, \"Degree\"]}"], "Input", CellLabel->"In[2]:=", CellID->200000052],
Cell[BoxData["RowBox[{\"{\", RowBox[{\"1\", \",\", \"8\"}], \"}\"}]"], "Output", CellLabel->"Out[3]=", CellID->200000053]
}, Open]],
Cell["UnknownCount is (n−1)² for a single patch: every boundary node is lifted
      away, leaving a square (n−1)×(n−1) interior system. RowCount equal to
      UnknownCount is the load-bearing half of that.", "ExampleText", CellID->200000054],
Cell[CellGroupData[{
Cell[BoxData["{SpectralDomainData[disc, \"UnknownCount\"], SpectralDomainData[disc, \"RowCount\"]}"], "Input", CellLabel->"In[4]:=", CellID->200000055],
Cell[BoxData["RowBox[{\"{\", RowBox[{\"49\", \",\", \"49\"}], \"}\"}]"], "Output", CellLabel->"Out[5]=", CellID->200000056]
}, Open]],
Cell["There are n+1 Chebyshev-Gauss-Lobatto nodes per direction.", "ExampleText", CellID->200000057],
Cell[CellGroupData[{
Cell[BoxData["Length[SpectralDomainData[disc, \"Nodes\"]]"], "Input", CellLabel->"In[6]:=", CellID->200000058],
Cell[BoxData["\"9\""], "Output", CellLabel->"Out[7]=", CellID->200000059]
}, Open]],
Cell["\"Coordinates\" returns one {x, y} pair per node, so on a one-patch
      degree-8 domain it is shaped {1, 9, 9, 2}. It is the pairing of \"X\" and
      \"Y\", which differ from it by 0. to machine precision.", "ExampleText", CellID->200000060],
Cell[CellGroupData[{
Cell[BoxData["Dimensions[SpectralDomainData[disc, \"Coordinates\"]]"], "Input", CellLabel->"In[8]:=", CellID->200000061],
Cell[BoxData["RowBox[{\"{\", RowBox[{\"1\", \",\", \"9\", \",\", \"9\", \",\", \"2\"}], \"}\"}]"], "Output", CellLabel->"Out[9]=", CellID->200000062]
}, Open]],
Cell["A one-patch domain has no second patch to share an edge with.", "ExampleText", CellID->200000063],
Cell[CellGroupData[{
Cell[BoxData["{SpectralDomainData[disc, \"InterfacePairs\"], Length[SpectralDomainData[disc, \"InterfacePairs\"]]}"], "Input", CellLabel->"In[10]:=", CellID->200000064],
Cell[BoxData["RowBox[{\"{\", RowBox[{RowBox[{\"{\", \"}\"}], \",\", \"0\"}], \"}\"}]"], "Output", CellLabel->"Out[11]=", CellID->200000065]
}, Open]],
Cell["MinJacobian has one entry per patch. Here the map is the identity on the
      unit square, so the analytic value is 1 and the computed value is 1 to
      the accuracy of the Chebyshev differentiation matrix.", "ExampleText", CellID->200000066],
Cell[CellGroupData[{
Cell[BoxData["SpectralDomainData[disc, \"MinJacobian\"]"], "Input", CellLabel->"In[12]:=", CellID->200000067],
Cell[BoxData["RowBox[{\"{\", \"0.9999999999999941`\", \"}\"}]"], "Output", CellLabel->"Out[13]=", CellID->200000068]
}, Open]],
Cell["The larger structures are lists. Note that \"Coordinates\" is among them
      even though Keys[disc] does not list it -- it is served by the accessor.", "ExampleText", CellID->200000069],
Cell[CellGroupData[{
Cell[BoxData["Map[{#, Head[SpectralDomainData[disc, #]]} &,
     {\"Nodes\", \"Coordinates\", \"PatchMap\", \"Jacobian\", \"InteriorRows\", \"BoundaryRows\", \"FluxRows\"}]"], "Input", CellLabel->"In[14]:=", CellID->200000070],
Cell[BoxData["RowBox[{\"{\", RowBox[{RowBox[{\"{\", RowBox[{\"\\\"Nodes\\\"\", \",\", \"List\"}], \"}\"}], \",\", RowBox[{\"{\", RowBox[{\"\\\"Coordinates\\\"\", \",\", \"List\"}], \"}\"}], \",\", RowBox[{\"{\", RowBox[{\"\\\"PatchMap\\\"\", \",\", \"List\"}], \"}\"}], \",\", RowBox[{\"{\", RowBox[{\"\\\"Jacobian\\\"\", \",\", \"List\"}], \"}\"}], \",\", RowBox[{\"{\", RowBox[{\"\\\"InteriorRows\\\"\", \",\", \"List\"}], \"}\"}], \",\", RowBox[{\"{\", RowBox[{\"\\\"BoundaryRows\\\"\", \",\", \"List\"}], \"}\"}], \",\", RowBox[{\"{\", RowBox[{\"\\\"FluxRows\\\"\", \",\", \"List\"}], \"}\"}]}], \"}\"}]"], "Output", CellLabel->"Out[15]=", CellID->200000071]
}, Open]],
Cell["An unknown key is refused by name, and the message lists the keys that
      do exist.", "ExampleText", CellID->200000072],
Cell[CellGroupData[{
Cell[BoxData["SpectralDomainData[disc, \"NoSuchKey\"]"], "Input", CellLabel->"In[16]:=", CellID->200000073],
Cell[BoxData["\"$Failed\""], "Output", CellLabel->"Out[17]=", CellID->200000074]
}, Open]],
Cell["Several keys at once, which is the easy way to inspect a discretization.", "ExampleText", CellID->200000075],
Cell[CellGroupData[{
Cell[BoxData["Map[SpectralDomainData[disc, #] &, {\"PatchCount\", \"Degree\", \"UnknownCount\", \"RowCount\", \"MinJacobian\", \"InterfacePairs\"}]"], "Input", CellLabel->"In[18]:=", CellID->200000076],
Cell[BoxData["RowBox[{\"{\", RowBox[{\"1\", \",\", \"8\", \",\", \"49\", \",\", \"49\", \",\", RowBox[{\"{\", \"0.9999999999999941`\", \"}\"}], \",\", RowBox[{\"{\", \"}\"}]}], \"}\"}]"], "Output", CellLabel->"Out[19]=", CellID->200000077]
}, Open]]
}, Open]]
