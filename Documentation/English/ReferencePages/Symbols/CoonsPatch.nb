Cell[BoxData[GridBox[{{Cell["CoonsPatch", "ObjectName"]}}]], "ObjectNameGrid",
  CellID->200000002],
Cell[BoxData[GridBox[{{"", Cell[TextData[{
  Cell[BoxData["CoonsPatch[{bottom, top, left, right}, opts]"], "InlineFormula"],
  " \[LineSeparator]",
  "CoonsPatch[{bottom, top, left, right}, opts] builds a transfinite (Coons) patch of the reference square ·-1 <= ξ <= 1, η <= 1 from four boundary curves, each given as a pure function of one parameter t that maps to a point {x, y}.  bottom and top are parameterized by t = ξ in −1 <= t <= 1 and sit at η = −1 and η = 1;  left and right are parameterized by t = η in −1 <= t <= 1 and sit at ξ = −1 and ξ = 1.  The four corner values must agree to within 1*^-12 or CoonsPatch::corners is issued.  Returns a CoonsPatch object whose map CoonsPatchMap[#1, ξ, η] evaluates to {x, y} on the curved domain.  Options include Method -> \"Analytic\" (default) or Method -> \"AAA\"."
}]]}}]], "Usage", CellID->982511436]
}, Open]],
Cell[CellGroupData[{
Cell[BoxData["Details and Options"], "NotesSection",
  WholeCellGroupOpener->True, CellGroupingRules->{"SectionGrouping", 50},
  CellID->200000003],
Cell[BoxData["The first argument is a list of exactly four boundary curves, each a pure
          function t \\[Function] {x, y}. bottom and top are parameterized by t = ξ
          with −1 <= t <= 1 and lie on η = −1 and η = 1; left and right are
          parameterized by t = η and lie on ξ = −1 and ξ = 1. The order is {bottom,
          top, left, right}, so the two ξ-edges come before the two η-edges."], "Notes", CellID->200000004],
Cell[BoxData["Corner closure is checked, not assumed. The four corner values must agree
          to within CornerTolerance, 1*^-12 by default; otherwise
          CoonsPatch::corners is issued and the patch is refused."], "Notes", CellID->200000005],
Cell[BoxData["Patch vertices must be true corners of the domain. On a smooth closed
          boundary the two edges meeting at a vertex are tangent to each other
          there, so the transfinite map's Jacobian vanishes and every operator built
          from the metric coefficients is singular. Geometry.wl measures the corner
          tangents and raises CoonsPatch::tangent when they are not independent; it
          reports the condition rather than discarding the patch."], "Notes", CellID->200000006],
Cell[BoxData["The map is the bilinear blend of the four boundary curves with the corner
          contributions subtracted, and it is exposed by CoonsPatchMap. The metric
          coefficients and the Jacobian follow from it analytically, so the
          discretized Laplacian needs no mesh generation."], "Notes", CellID->200000007],
Cell[BoxData["Options"], "NotesHead", CellID->200000008],
Cell[BoxData[GridBox[{{"{\"Method\", \"Analytic\"} (default)",
   "evaluates the four edge curves exactly"},
{"{\"Method\", \"AAA\"}",
   "samples each edge and fits it with the AAA rational core"},
{"{\"CornerTolerance\", 1*^-12}",
   "how far the four corners may disagree"},
{"{\"AAASamples\", 65}",
   "sample count per edge on the AAA path"}}]], "Notes", CellID->200000009],
Cell[BoxData["Method -> \"AAA\" never falls back silently. An unrecognised method name, an
          edge that does not sample to a finite real numeric vector, and an AAA fit
          that fails or is not finite on its own sample interval are all rejections:
          the patch is refused with CoonsPatch::method, because a fallback would
          pass off a bad boundary as a good one."], "Notes", CellID->200000010],
Cell[BoxData["The returned object"], "NotesHead", CellID->200000011],
Cell[BoxData["The result is an Association whose keys are Type, Edges, Corners,
          CornerClosure, CornerConsistency, CrossAtCorners, CornerTolerance, Method,
          AAA, Map and Domain. There is deliberately no Format rule: a Format
          left-hand side is evaluated when it is set, so one written over the bare
          pattern would be rejected by the CoonsPatch catch-all on every load.
          CoonsPatchQ checks the Type tag rather than the field pattern alone."], "Notes", CellID->200000012],
Cell[BoxData["Messages"], "NotesHead", CellID->200000013],
Cell[BoxData["CoonsPatch::edges -- not exactly four pure functions of one variable.
          CoonsPatch::corners -- the four edges do not close at the corners.
          CoonsPatch::tangent -- the corner tangents are degenerate.
          CoonsPatch::method -- an unusable Method value, or a failed AAA fit."], "Notes", CellID->200000014]
}, Open]],
Cell[CellGroupData[{
Cell[BoxData[{"Examples", "\[NonBreakingSpace]\[NonBreakingSpace]", Cell["(1)", "ExampleCount"]}],
  "PrimaryExamplesSection", CellTags->"PrimaryExamplesSection",
  CellID->200000015],
Cell[CellGroupData[{
Cell[BoxData["Basic Examples"], "ExampleSection", "ExampleSection",
  WholeCellGroupOpener->True, CellID->200000016],
Cell["Load the package:", "ExampleText", CellID->200000017],
Cell[CellGroupData[{
Cell[BoxData["Needs[\"SpectralElement`\"];
Null"], "Input", CellLabel->"In[1]:=", CellID->200000018],
Cell[BoxData["\"Null\""], "Output", CellLabel->"Out[2]=", CellID->200000019]
}, Open]],
Cell["The four boundary curves of a curved quadrilateral, each a pure function
      of one parameter. The result is an Association; these are its keys.", "ExampleText", CellID->200000020],
Cell[CellGroupData[{
Cell[BoxData["edges = {Function[t, {2 t, -1}], Function[t, {2 t, 1}],
         Function[t, {-2, t}], Function[t, {2, t}]};
patch = CoonsPatch[edges];
Keys[patch]"], "Input", CellLabel->"In[3]:=", CellID->200000021],
Cell[BoxData["RowBox[{\"{\", RowBox[{\"\\\"Type\\\"\", \",\", \"\\\"Edges\\\"\", \",\", \"\\\"Corners\\\"\", \",\", \"\\\"CornerClosure\\\"\", \",\", \"\\\"CornerConsistency\\\"\", \",\", \"\\\"CrossAtCorners\\\"\", \",\", \"\\\"CornerTolerance\\\"\", \",\", \"\\\"Method\\\"\", \",\", \"\\\"AAA\\\"\", \",\", \"\\\"Map\\\"\", \",\", \"\\\"Domain\\\"\"}], \"}\"}]"], "Output", CellLabel->"Out[4]=", CellID->200000022]
}, Open]],
Cell["For these four straight edges the corner closure is 0. exactly, and the
      tolerance it was checked against is the default 1*^-12.", "ExampleText", CellID->200000023],
Cell[CellGroupData[{
Cell[BoxData["{patch[\"Method\"], patch[\"CornerClosure\"], patch[\"CornerTolerance\"]}"], "Input", CellLabel->"In[5]:=", CellID->200000024],
Cell[BoxData["RowBox[{\"{\", RowBox[{\"\\\"Analytic\\\"\", \",\", \"0.`\", \",\", \"1.`*^-12\"}], \"}\"}]"], "Output", CellLabel->"Out[6]=", CellID->200000025]
}, Open]],
Cell["Method -> \"AAA\" fits each sampled edge with the AAA rational core
      instead of evaluating the curves symbolically. The patch is tagged \"AAA\"
      -- there is no silent fallback to \"Analytic\" -- and the fit record
      reports its sample count.", "ExampleText", CellID->200000026],
Cell[CellGroupData[{
Cell[BoxData["aaa = CoonsPatch[edges, Method -> \"AAA\"];
{aaa[\"Method\"], CoonsPatchQ[aaa], aaa[\"AAA\"][\"Samples\"]}"], "Input", CellLabel->"In[7]:=", CellID->200000027],
Cell[BoxData["RowBox[{\"{\", RowBox[{\"\\\"AAA\\\"\", \",\", \"True\", \",\", \"65\"}], \"}\"}]"], "Output", CellLabel->"Out[8]=", CellID->200000028]
}, Open]],
Cell["A patch needs exactly four edges. Three is a refusal, not a partial
      patch.", "ExampleText", CellID->200000029],
Cell[CellGroupData[{
Cell[BoxData["CoonsPatch[Take[edges, 3]]"], "Input", CellLabel->"In[9]:=", CellID->200000030],
Cell[BoxData["\"$Failed\""], "Output", CellLabel->"Out[10]=", CellID->200000031]
}, Open]],
Cell["The four edges must also close at the corners. These do not: the top
      edge has been moved up by half a unit, which the corner test catches
      before anything is built.", "ExampleText", CellID->200000032],
Cell[CellGroupData[{
Cell[BoxData["CoonsPatch[{Function[t, {2 t, -1}], Function[t, {2 t, 1.5}],
            Function[t, {-2, t}], Function[t, {2, t}]}]"], "Input", CellLabel->"In[11]:=", CellID->200000033],
Cell[BoxData["\"$Failed\""], "Output", CellLabel->"Out[12]=", CellID->200000034]
}, Open]],
Cell["An unrecognised method name is refused, never downgraded.", "ExampleText", CellID->200000035],
Cell[CellGroupData[{
Cell[BoxData["CoonsPatch[edges, Method -> \"NoSuchMethod\"]"], "Input", CellLabel->"In[13]:=", CellID->200000036],
Cell[BoxData["\"$Failed\""], "Output", CellLabel->"Out[14]=", CellID->200000037]
}, Open]]
}, Open]]
