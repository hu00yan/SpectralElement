Cell["Set up a patch to test.", "ExampleText", CellID->200000015],
Cell[CellGroupData[{
Cell[BoxData["edges = {Function[t, {2 t, -1}], Function[t, {2 t, 1}],
         Function[t, {-2, t}], Function[t, {2, t}]};
patch = CoonsPatch[edges];
None"], "Input", CellLabel->"In[1]:=", CellID->200000016]
}, Open]],
Cell["A patch that CoonsPatch built is recognized.", "ExampleText", CellID->200000017],
