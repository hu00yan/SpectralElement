Cell[CellGroupData[{
Cell[BoxData["Details and Options"], "NotesSection",
  WholeCellGroupOpener->True, CellGroupingRules->{"SectionGrouping", 50},
  CellID->200000052],
Cell[BoxData["SpectralNDSolveValue takes the same arguments and options as
          SpectralNDSolve and gives the solution as a pure function, with no rule
          wrapper. Head[sol] is Function, so the answer is used directly as f[a, b]."], "Notes", CellID->200000053],
Cell[BoxData["The result is bit-identical to the interpolator inside SpectralNDSolve:
          solving the same problem both ways and comparing at a point gives 0.
          exactly, not a small number."], "Notes", CellID->200000054],
Cell[BoxData["Everything on the SpectralNDSolve page applies here -- the domain forms,
          the Dirichlet default, the options, the sign convention, the refusal
          contract and the messages."], "Notes", CellID->200000055],
Cell[BoxData["The returned function takes scalars, so map it as Function[...] & /@
          points or with Apply[f, pts, {1}]."], "Notes", CellID->200000056]
}, Open]],
Cell[CellGroupData[{
Cell[BoxData[{"Examples", "\[NonBreakingSpace]\[NonBreakingSpace]", Cell["(1)", "ExampleCount"]}],
  "PrimaryExamplesSection", CellTags->"PrimaryExamplesSection",
  CellID->200000057],
Cell[CellGroupData[{
Cell[BoxData["Basic Examples"], "ExampleSection", "ExampleSection",
  WholeCellGroupOpener->True, CellID->200000058],
Cell["A manufactured solution and its boundary data, as on the SpectralNDSolve
      page. solV is the value form of the degree-16 linear solve.", "ExampleText", CellID->200000059],
Cell[CellGroupData[{
Cell[BoxData["uexz[x_, y_] := Sin[2 x + 1] Cos[3 y - 1] + x y/5;
fLin = -Laplacian[uexz[x, y], {x, y}];
bd = Abs[x + 1.5] < 1.*^-8 || Abs[x - 1.8] < 1.*^-8 ||
     Abs[y + 1.2] < 1.*^-8 || Abs[y - 1.3] < 1.*^-8;
solV = SpectralNDSolveValue[{-Laplacian[u[x, y], {x, y}] == fLin,
    DirichletCondition[u[x, y] == uexz[x, y], bd]}, u,
  {x, y} ∈ Rectangle[{-1.5, -1.2}, {1.8, 1.3}], 16];
Head[solV]"], "Input", CellLabel->"In[1]:=", CellID->200000060],
Cell[BoxData["\"Function\""], "Output", CellLabel->"Out[2]=", CellID->200000061]
}, Open]],
Cell["Its head is Function, so it is used directly as f[a, b].", "ExampleText", CellID->200000062],
Cell[CellGroupData[{
Cell[BoxData["solV[-0.5, 0.3]"], "Input", CellLabel->"In[3]:=", CellID->200000063],
Cell[BoxData["RowBox[{\"-\", \"0.02999999999604433`\"}]"], "Output", CellLabel->"Out[4]=", CellID->200000064]
}, Open]],
Cell["And it is bit-identical to the interpolator inside SpectralNDSolve: the
      difference at a point is 0. exactly.", "ExampleText", CellID->200000065],
Cell[CellGroupData[{
Cell[BoxData["solR = SpectralNDSolve[{-Laplacian[u[x, y], {x, y}] == fLin,
     DirichletCondition[u[x, y] == uexz[x, y], bd]}, u,
   {x, y} ∈ Rectangle[{-1.5, -1.2}, {1.8, 1.3}], 16];
Abs[solV[0.1, 0.2] - solR[[1, 1, 2]][0.1, 0.2]]"], "Input", CellLabel->"In[5]:=", CellID->200000066],
Cell[BoxData["\"0.`\""], "Output", CellLabel->"Out[6]=", CellID->200000067]
}, Open]],
Cell["The same entry point on the nonlinear problem, via Newton's method.", "ExampleText", CellID->200000068],
Cell[CellGroupData[{
Cell[BoxData["fNl = fLin + uexz[x, y]^3;
solNv = SpectralNDSolveValue[{-Laplacian[u[x, y], {x, y}] + u[x, y]^3 == fNl,
    DirichletCondition[u[x, y] == uexz[x, y], bd]}, u,
  {x, y} ∈ Rectangle[{-1.5, -1.2}, {1.8, 1.3}], 16];
solNv[-0.5, 0.3]"], "Input", CellLabel->"In[7]:=", CellID->200000069],
Cell[BoxData["RowBox[{\"-\", \"0.029999999996180738`\"}]"], "Output", CellLabel->"Out[8]=", CellID->200000070]
}, Open]],
Cell["The curved patch again: four concave quadratic arcs.", "ExampleText", CellID->200000071],
Cell[CellGroupData[{
Cell[BoxData["gamma = 0.4;
bot = Function[t, {t, -1 + gamma (1 - t^2)}];
top = Function[t, {t,  1 - gamma (1 - t^2)}];
lef = Function[t, {-1 + gamma (1 - t^2), t}];
rig = Function[t, { 1 - gamma (1 - t^2), t}];
cpatch = CoonsPatch[{bot, top, lef, rig}];
uex2[x_, y_] := Sin[2 x + 1] Cos[3 y - 1] + x y/5;
fL2 = -Laplacian[uex2[x, y], {x, y}];
onPatch = Abs[y + 1 - gamma (1 - x^2)] < 1.*^-8 || Abs[y - 1 + gamma (1 - x^2)] < 1.*^-8 ||
         Abs[x + 1 - gamma (1 - y^2)] < 1.*^-8 || Abs[x - 1 + gamma (1 - y^2)] < 1.*^-8;
None"], "Input", CellLabel->"In[9]:=", CellID->200000072]
}, Open]],
Cell["Solving on it in value form gives the same centre value.", "ExampleText", CellID->200000073],
Cell[CellGroupData[{
Cell[BoxData["SpectralNDSolveValue[{-Laplacian[u[x, y], {x, y}] == fL2,
     DirichletCondition[u[x, y] == uex2[x, y], onPatch]}, u, {x, y} ∈ {cpatch}, 14][0, 0]"], "Input", CellLabel->"In[10]:=", CellID->200000074],
Cell[BoxData["\"0.4546487121705494`\""], "Output", CellLabel->"Out[11]=", CellID->200000075]
}, Open]],
Cell["Method -> \"Linear\" on the linear problem is the same answer again, to 0.
      exactly -- the option forces the path, it does not change the solution.", "ExampleText", CellID->200000076],
Cell[CellGroupData[{
Cell[BoxData["solVL = SpectralNDSolveValue[{-Laplacian[u[x, y], {x, y}] == fLin,
     DirichletCondition[u[x, y] == uexz[x, y], bd]}, u,
   {x, y} ∈ Rectangle[{-1.5, -1.2}, {1.8, 1.3}], 16, Method -> \"Linear\"];
Abs[solVL[0.1, 0.2] - solV[0.1, 0.2]]"], "Input", CellLabel->"In[12]:=", CellID->200000077],
Cell[BoxData["\"0.`\""], "Output", CellLabel->"Out[13]=", CellID->200000078]
}, Open]],
Cell["And the refusal contract is the same: Dirichlet data that is not a
      number returns $Failed with SpectralNDSolve::nlift.", "ExampleText", CellID->200000079],
Cell[CellGroupData[{
Cell[BoxData["gd[a_, b_] := gUndefined[a, b];
SpectralNDSolveValue[{-Laplacian[u[x, y], {x, y}] == 1,
    DirichletCondition[u[x, y] == gd[x, y], Abs[x] < 1.*^-8 || Abs[x - 1.] < 1.*^-8 ||
      Abs[y] < 1.*^-8 || Abs[y - 1.] < 1.*^-8]}, u,
  {x, y} ∈ Rectangle[{-1, -1}, {1, 1}], 12]"], "Input", CellLabel->"In[14]:=", CellID->200000080],
Cell[BoxData["\"$Failed\""], "Output", CellLabel->"Out[15]=", CellID->200000081]
}, Open]]
}, Open]]
}, Open]],
