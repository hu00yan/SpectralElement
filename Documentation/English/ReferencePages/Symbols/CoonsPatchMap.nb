Cell[BoxData[GridBox[{{"", Cell[TextData[{
  Cell[BoxData["CoonsPatchMap[patch, ξ, η]"], "InlineFormula"],
  " \[LineSeparator]",
  "CoonsPatchMap[patch, ξ, η] evaluates the transfinite (Coons) map of patch at the reference-square coordinates ξ, η and returns the point {x, y} on the curved domain."
}]]}}]], "Usage", CellID->982511436]
}, Open]],
Cell[CellGroupData[{
Cell[BoxData["Details and Options"], "NotesSection",
  WholeCellGroupOpener->True, CellGroupingRules->{"SectionGrouping", 50},
  CellID->200000017],
Cell[BoxData["CoonsPatchMap[patch, ξ, η] evaluates the transfinite map of patch at the
          reference-square coordinates ξ and η and returns the point {x, y} on the
          curved domain. ξ and η run over −1 <= ξ <= 1 and −1 <= η <= 1."], "Notes", CellID->200000018],
Cell[BoxData["The map is closed and continuous at the four corners: evaluating it at
          (−1, −1) returns the bottom-left vertex of the domain exactly, for every
          patch whose edges close. That is what corner closure buys, and it is why
          the corner test is enforced at construction."], "Notes", CellID->200000019],
Cell[BoxData["Any argument that is not a valid patch object returns $Failed. The output
          is a pair of machine-precision reals, so compare with a tolerance rather
          than with Equal: the exact answer {0.6, −0.5} comes back as
          {0.5999999999999999, −0.5}."], "Notes", CellID->200000020]
}, Open]],
Cell[CellGroupData[{
Cell[BoxData[{"Examples", "\[NonBreakingSpace]\[NonBreakingSpace]", Cell["(1)", "ExampleCount"]}],
  "PrimaryExamplesSection", CellTags->"PrimaryExamplesSection",
  CellID->200000021],
Cell[CellGroupData[{
Cell[BoxData["Basic Examples"], "ExampleSection", "ExampleSection",
  WholeCellGroupOpener->True, CellID->200000022],
Cell["Set up a patch to map.", "ExampleText", CellID->200000023],
Cell[CellGroupData[{
Cell[BoxData["edges = {Function[t, {2 t, -1}], Function[t, {2 t, 1}],
         Function[t, {-2, t}], Function[t, {2, t}]};
patch = CoonsPatch[edges];
None"], "Input", CellLabel->"In[1]:=", CellID->200000024]
}, Open]],
Cell["The map at an interior point of the reference square. The exact answer
      is {0.6, −0.5}; the last-bit difference is floating point, so compare
      with a tolerance rather than with Equal.", "ExampleText", CellID->200000025],
Cell[CellGroupData[{
Cell[BoxData["CoonsPatchMap[patch, 0.3, -0.5]"], "Input", CellLabel->"In[2]:=", CellID->200000026],
Cell[BoxData["RowBox[{\"{\", RowBox[{\"0.5999999999999999`\", \",\", RowBox[{\"-\", \"0.5`\"}]}], \"}\"}]"], "Output", CellLabel->"Out[3]=", CellID->200000027]
}, Open]],
Cell["The map at a corner. This is the bottom-left vertex of the domain, and
      it comes back exactly -- which is what corner closure buys.", "ExampleText", CellID->200000028],
Cell[CellGroupData[{
Cell[BoxData["CoonsPatchMap[patch, -1., -1.]"], "Input", CellLabel->"In[4]:=", CellID->200000029],
Cell[BoxData["RowBox[{\"{\", RowBox[{RowBox[{\"-\", \"2.`\"}], \",\", RowBox[{\"-\", \"1.`\"}]}], \"}\"}]"], "Output", CellLabel->"Out[5]=", CellID->200000030]
}, Open]],
Cell["A 2×2 sample of the reference square, mapped.", "ExampleText", CellID->200000031],
Cell[CellGroupData[{
Cell[BoxData["Table[CoonsPatchMap[patch, xi, eta], {xi, -1, 1, 2}, {eta, -1, 1, 2}]"], "Input", CellLabel->"In[6]:=", CellID->200000032],
Cell[BoxData["RowBox[{\"{\", RowBox[{RowBox[{\"{\", RowBox[{RowBox[{\"{\", RowBox[{RowBox[{\"-\", \"2\"}], \",\", RowBox[{\"-\", \"1\"}]}], \"}\"}], \",\", RowBox[{\"{\", RowBox[{RowBox[{\"-\", \"2\"}], \",\", \"1\"}], \"}\"}]}], \"}\"}], \",\", RowBox[{\"{\", RowBox[{RowBox[{\"{\", RowBox[{\"2\", \",\", RowBox[{\"-\", \"1\"}]}], \"}\"}], \",\", RowBox[{\"{\", RowBox[{\"2\", \",\", \"1\"}], \"}\"}]}], \"}\"}]}], \"}\"}]"], "Output", CellLabel->"Out[7]=", CellID->200000033]
}, Open]],
Cell["The same on a genuinely curved patch: four concave quadratic arcs, each
      side pushed inward by 0.4 at its midpoint.", "ExampleText", CellID->200000034],
Cell[CellGroupData[{
Cell[BoxData["gamma = 0.4;
bot = Function[t, {t, -1 + gamma (1 - t^2)}];
top = Function[t, {t,  1 - gamma (1 - t^2)}];
lef = Function[t, {-1 + gamma (1 - t^2), t}];
rig = Function[t, { 1 - gamma (1 - t^2), t}];
cp = CoonsPatch[{bot, top, lef, rig}];
None"], "Input", CellLabel->"In[8]:=", CellID->200000035]
}, Open]],
Cell["The centre maps to the centre, the left edge of the reference square
      maps to the left curved edge, and the corner to the corner.", "ExampleText", CellID->200000036],
Cell[CellGroupData[{
Cell[BoxData["{CoonsPatchMap[cp, 0, 0], CoonsPatchMap[cp, -1., 0.], CoonsPatchMap[cp, 1., -1.]}"], "Input", CellLabel->"In[9]:=", CellID->200000037],
Cell[BoxData["RowBox[{\"{\", RowBox[{RowBox[{\"{\", RowBox[{\"0.`\", \",\", \"0.`\"}], \"}\"}], \",\", RowBox[{\"{\", RowBox[{RowBox[{\"-\", \"0.6000000000000001`\"}], \",\", \"0.`\"}], \"}\"}], \",\", RowBox[{\"{\", RowBox[{\"1.`\", \",\", RowBox[{\"-\", \"1.`\"}]}], \"}\"}]}], \"}\"}]"], "Output", CellLabel->"Out[10]=", CellID->200000038]
}, Open]]
}, Open]]
}, Open]],
